    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.gemini_api_base }}/models/{{ $('Config').first().json.gemini_model }}:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": {{ JSON.stringify(\"You are a B2B lead scoring assistant for \" + $('Config').first().json.company_name + \". Score how likely this lead is to become a paying customer.\\n\\nScoring criteria: \" + $('Config').first().json.scoring_criteria + \"\\n\\nReturn ONLY a JSON object with these keys: score (number 0-100), category (HOT, WARM or COLD), reason (one short sentence), priority (HIGH, NORMAL or LOW), recommended_action (one short sentence).\\n\\nLead:\\nCompany: \" + $json.company + \"\\nIndustry: \" + $json.industry + \"\\nEmployees: \" + $json.employees + \"\\nBudget: \" + $json.budget + \"\\nService: \" + $json.service + \"\\nMessage: \" + $json.message) }}\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"temperature\": 0.2\n  }\n}",
        "options": {
          "timeout": 30000
        }
      },
      "name": "AI Scoring (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1680,
        300
      ],
      "id": "cf793ad6-7742-43a9-a3c3-784df58e2282",
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Reads Gemini's answer safely.\n// If the AI call failed or returned something unreadable, ai_ok is false\n// and the lead is scored with the business rules only (see Final Score).\nconst res = $input.item.json;\nlet ai = null;\ntry {\n  const text = res.candidates[0].content.parts[0].text;\n  ai = JSON.parse(String(text).replace(/^```(?:json)?\\s*|\\s*```$/g, ''));\n} catch (e) {\n  ai = null;\n}\nconst score = Number(ai && ai.score);\nconst ok = ai !== null && Number.isFinite(score);\n\nreturn {\n  json: {\n    ai_ok: ok,\n    ai_score: ok ? Math.max(0, Math.min(100, Math.round(score))) : null,\n    ai_reason: ok ? String(ai.reason || '') : 'AI unavailable, scored with business rules only',\n    ai_priority: ok ? String(ai.priority || 'NORMAL').toUpperCase() : 'NORMAL',\n    ai_action: ok ? String(ai.recommended_action || '') : 'Review this lead manually',\n  },\n};\n"
      },
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
