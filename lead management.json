            {
              "id": "h14",
              "name": "ai_reason",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).reason || '' }}",
              "type": "string"
            },
            {
              "id": "h15",
              "name": "ai_priority",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).priority || 'NORMAL' }}",
              "type": "string"
            },
            {
              "id": "h16",
              "name": "ai_action",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).recommended_action || '' }}",
              "type": "string"
            },
            {
              "id": "h17",
              "name": "rule_score",
              "value": "={{ ($('Generate Lead ID').item.json.budget >= 5000 ? 30 : $('Generate Lead ID').item.json.budget >= 2000 ? 25 : $('Generate Lead ID').item.json.budget >= 500 ? 15 : 5) + ($('Generate Lead ID').item.json.employees > 200 ? 20 : $('Generate Lead ID').item.json.employees >= 51 ? 15 : $('Generate Lead ID').item.json.employees >= 11 ? 10 : 5) + (/buy|start|now|immediately|ready/i.test($('Generate Lead ID').item.json.message || '') ? 30 : /need|want|implement|automate/i.test($('Generate Lead ID').item.json.message || '') ? 20 : /interested/i.test($('Generate Lead ID').item.json.message || '') ? 10 : 5) }}",
              "type": "number"
            }
          ]
