            {
              "id": "x2",
              "name": "category",
              "value": "={{ Math.round($json.rule_score * 0.6 + $json.ai_score * 0.4) >= 80 ? 'HOT' : Math.round($json.rule_score * 0.6 + $json.ai_score * 0.4) >= 50 ? 'WARM' : 'COLD' }}",
              "type": "string"
