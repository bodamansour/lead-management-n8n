    {
      "parameters": {
        "method": "POST",
        "url": "https://aistudio.google.com/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": {{ JSON.stringify(\"You are a B2B lead scoring assistant. Analyze the lead and return ONLY a JSON object with keys: score (number 0-100), category (HOT/WARM/COLD), reason, priority (HIGH/NORMAL/LOW), recommended_action.\\n\\nLead:\\nName: \" + $json.name + \"\\nCompany: \" + $json.company + \"\\nIndustry: \" + $json.industry + \"\\nEmployees: \" + $json.employees + \"\\nBudget: \" + $json.budget + \"\\nService: \" + $json.service + \"\\nMessage: \" + $json.message) }}\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": { \"response_mime_type\": \"application/json\" }\n}",
        "options": {}
      },
      "id": "69f6daaa-17e7-480f-b335-a979e62c5138",
      "name": "AI Scoring (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
